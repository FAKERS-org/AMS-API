# Environment Configuration for AMS API

# App settings
APP_NAME="AMS API"
DEBUG=true

# Database URL (PostgreSQL with asyncpg driver)
# Note: When using docker-compose, port 4545 is mapped to container port 5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:4545/ams_db

# Security & JWT Configuration
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated or JSON list depending on pydantic-settings)
CORS_ORIGINS=["http://localhost:3000"]

